# SPRITZ — local env vars
# Copy to `.env.local` and fill in values. Never commit `.env.local`.

# Shopify Storefront API.
# Get these from your Shopify admin:
#   Settings → Apps and sales channels → Develop apps → Create an app →
#   Configure Storefront API scopes → Install app → Storefront API access tokens.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# AI scent finder (Claude API). Server-only — NO NEXT_PUBLIC_ prefix.
# Get a key at https://console.anthropic.com/settings/keys
# Without it the finder shows a graceful fallback (all five scents).
ANTHROPIC_API_KEY=

# Newsletter popup discount code shown after signup.
# Create the matching code in Shopify admin (Discounts) or it won't apply.
# Defaults to SPRITZ20 when unset.
NEWSLETTER_DISCOUNT_CODE=SPRITZ20
