{
  "name": "spritz-ops",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "sync-ds": "node scripts/sync-ds.mjs",
    "prebuild": "node scripts/sync-ds.mjs --check",
    "predev": "node scripts/sync-ds.mjs",
    "dev": "next dev -p 4100",
